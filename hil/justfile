# HARDWARIO TOWER HIL harness (`tower-hil`): task runner (https://just.systems). Run from this
# directory, or from the repo root as `just hil <recipe>`.
#
# The harness drives the real bench: a TOWER Core Module (J-Link SWD + Nordic PPK2) and a
# TOWER Radio Dongle (USB). It builds the images under test from the firmware workspace,
# default `../firmware` (its sibling in the monorepo); override with TOWER_FIRMWARE_DIR. The
# bench roster lives in hil.toml
# (re-resolved against `tower devices` at startup). Needs the `tower` CLI and `just` on PATH;
# the power group also needs probe-rs + python3 (the ppk2d.py sidecar).
#
# This crate is a member of the repo's host workspace: `cargo test` here builds for the native
# host (only this package), COMPILES the `#[ignore]`d hardware tests, and runs none; `--ignored`
# (below) opts INTO the bench run.
#
# `--test-threads=1` is LOAD-BEARING: the serial ports are exclusive, so tests must not run
# concurrently.

# List the available recipes.
default:
    @just --list

# Needs the Dongle + Core; NOT run in CI. The `power` group is compiled out (no `power` feature),
# so this never touches the PPK2.
# `--no-fail-fast`: one red test binary must not skip the remaining groups: a 2026-07-05 run
# lost the whole smoke+radio pass to a single RF flake in extended.
# Run the smoke + radio + extended + gateway HIL groups on the bench (flashes hardware).
bench *args:
    cargo test --no-fail-fast -- --ignored --test-threads=1 {{args}}

# Needs the Core on J-Link + PPK2, PPK2-powered: its FTDI may stay plugged if it is a data-only
# adapter, no VBUS on the Core's USB.
# The `power_` name filter is load-bearing: `--features power` merely ADDS power.rs; without the
# filter, `--ignored` would ALSO run the smoke/radio/extended groups, whose `tower flash` of the
# FTDI-detached Core times out on a power bench. `bench-full` is the unfiltered "everything" run.
# Run ONLY the feature-gated power HIL group on the bench (flashes hardware).
bench-power *args:
    cargo test --no-fail-fast --features power -- --ignored --test-threads=1 power_ {{args}}

# Run every HIL group (smoke + radio + extended + gateway + power) on the fully-cabled bench.
bench-full *args:
    cargo test --no-fail-fast --features power -- --ignored --test-threads=1 {{args}}

# Compile the harness + every test group (incl. power) without touching hardware (what CI runs).
check:
    cargo test --locked --no-run --features power

# The target dir is the host workspace's (../target), shared with the other crates, so only this
# package's artifacts are removed.
# Remove this crate's build artifacts.
clean:
    cargo clean -p tower-hil
