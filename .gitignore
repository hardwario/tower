# Build output: the host workspace (root) and the separate firmware workspace.
/target
/firmware/target

# Release archives / staged binaries (e.g. `tower-cli-v1.0.0-aarch64-apple-darwin{,.tar.gz}`).
/tower-cli-v*

# cargo-mutants run without `--output` (`just mutants` writes to target/mutants/<crate>/).
/mutants.out*/

# insta: a changed TUI frame waiting for review (cli/src/snapshot.rs); the accepted `.snap`
# files are committed.
*.snap.new

# Python tooling (RAM-budget guard, hwtest scripts, the PPK2 sidecar).
__pycache__/
*.pyc
/hil/.venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Claude Code agent worktrees (temporary checkouts)
.claude/worktrees/
